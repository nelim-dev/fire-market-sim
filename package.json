{
  "name": "fire-market-sim",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "test:m1": "tsx tests/console/m1.test.ts",
    "test:m2": "tsx tests/console/m2.test.ts",
    "test:m3": "tsx tests/console/m3-catalog-selectors.test.ts && tsx tests/console/m3-market-quote-clip.test.ts && tsx tests/console/m3-minute-bar-aggregation.test.ts && tsx tests/console/m3-market-runtime-contract.test.ts && tsx tests/console/m3-chart-windows.test.ts && tsx tests/console/m3-dividend-eligibility.test.ts",
    "test:m4": "tsx tests/console/m4-trading-and-ui-contract.test.ts && tsx tests/console/m4-extended.test.ts",
    "test:m5": "tsx tests/console/stub-milestone.ts M5",
    "test:m6": "tsx tests/console/stub-milestone.ts M6",
    "test:m7": "tsx tests/console/stub-milestone.ts M7",
    "test:m8": "tsx tests/console/stub-milestone.ts M8",
    "test:m9": "tsx tests/console/stub-milestone.ts M9",
    "test:m10": "tsx tests/console/stub-milestone.ts M10",
    "test:all": "npm run test:m1 && npm run test:m2 && npm run test:m3 && npm run test:m4 && npm run test:m5 && npm run test:m6 && npm run test:m7 && npm run test:m8 && npm run test:m9 && npm run test:m10",
    "gen:calendar": "tsx scripts/build-trading-calendar.ts",
    "gen:market-catalog": "tsx scripts/generate-market-instrument-catalog.ts",
    "gen:instrument-details": "tsx scripts/build-instrument-details-catalog.ts",
    "build:market-db": "tsx scripts/build-market-sqlite.ts",
    "download:moex-bonds": "npm --prefix downloadStockData run download:bonds",
    "download:moex-bonds:smoke": "npm --prefix downloadStockData run download:bonds:smoke",
    "download:moex-stocks": "npm --prefix downloadStockData run download:stocks",
    "download:moex-stocks:smoke": "npm --prefix downloadStockData run download:stocks:smoke",
    "download:moex-funds": "npm --prefix downloadStockData run download:funds",
    "download:moex-funds:smoke": "npm --prefix downloadStockData run download:funds:smoke",
    "download:moex-bonds:incremental": "npm --prefix downloadStockData run download:bonds:incremental",
    "download:moex-stocks:incremental": "npm --prefix downloadStockData run download:stocks:incremental",
    "download:moex-funds:incremental": "npm --prefix downloadStockData run download:funds:incremental",
    "test:download-stock-data": "npm --prefix downloadStockData test",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && npm run build:market-db && electron-builder",
    "electron:start": "electron ."
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.firemarketsim.app",
    "productName": "FIRE Market Simulator",
    "extraResources": [
      {
        "from": "data/market.sqlite",
        "to": "."
      },
      {
        "from": "data/tradingCalendar.json",
        "to": "."
      }
    ],
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  }
}
